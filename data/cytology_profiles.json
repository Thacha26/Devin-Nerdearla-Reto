{
  "_meta": {
    "title": "EIRA Cervical Cytology Form - fictional demo profiles",
    "fictional": true,
    "assumed_form": true,
    "note": "The form skeleton below is ASSUMED, not EIRA's official form. It follows the Bethesda 2014 system and fields common in Mexican cervical cytology requests (NOM-014-SSA2). Field numbers were chosen so that 26 = sample adequacy, 28.1 = repeat reason and 30 = pathologist review. Replace with EIRA's real form when available. All people and data are fictional."
  },

  "form": [
    {"field": "1",    "key": "1_folio",                       "label": "Form number (folio)",                     "type": "text"},
    {"field": "2",    "key": "2_id_eira",                     "label": "EIRA patient ID",                         "type": "text"},
    {"field": "3",    "key": "3_full_name",                   "label": "Full name",                               "type": "text"},
    {"field": "4",    "key": "4_national_id",                 "label": "CURP",                                    "type": "text"},
    {"field": "5",    "key": "5_birth_date",                  "label": "Date of birth",                           "type": "date"},
    {"field": "6",    "key": "6_age",                         "label": "Age (years)",                             "type": "integer"},
    {"field": "7",    "key": "7_affiliation",                 "label": "Affiliation",                             "type": "option",
     "options": ["INSABI", "IMSS", "ISSSTE", "PEMEX", "SEDENA", "SEMAR", "OTHER", "NONE"]},
    {"field": "8",    "key": "8_health_unit",                 "label": "Health unit where the sample was taken",  "type": "text"},

    {"field": "9",    "key": "9_sample_date",                 "label": "Date sample was taken",                   "type": "date"},
    {"field": "10",   "key": "10_last_menstrual_period",      "label": "Last menstrual period",                   "type": "date", "nullable": true},
    {"field": "11",   "key": "11_gestations",                 "label": "Gestations",                              "type": "integer"},
    {"field": "12",   "key": "12_vaginal_births",             "label": "Vaginal births",                          "type": "integer"},
    {"field": "13",   "key": "13_cesareans",                  "label": "Cesarean sections",                       "type": "integer"},
    {"field": "14",   "key": "14_abortions",                  "label": "Abortions",                               "type": "integer"},
    {"field": "15",   "key": "15_contraceptive_method",       "label": "Current contraceptive method",            "type": "option",
     "options": ["1. None", "2. Oral hormonal", "3. Injectable", "4. Implant", "5. IUD", "6. Condom", "7. Tubal ligation", "8. Other"]},
    {"field": "16",   "key": "16_pregnant",                   "label": "Currently pregnant",                      "type": "option", "options": ["1. Yes", "2. No"]},
    {"field": "17",   "key": "17_menopause",                  "label": "Menopause",                               "type": "option", "options": ["1. Yes", "2. No"]},
    {"field": "18",   "key": "18_previous_cytology",          "label": "Previous cervical cytology",              "type": "option", "options": ["1. Yes", "2. No", "3. Does not know"]},
    {"field": "18.1", "key": "18.1_previous_cytology_year",   "label": "Year of previous cytology",               "type": "integer", "nullable": true},
    {"field": "19",   "key": "19_previous_abnormal_result",   "label": "Previous abnormal result",                "type": "option", "options": ["1. Yes", "2. No", "3. Does not know"], "nullable": true},
    {"field": "20",   "key": "20_hpv_vaccine",                "label": "HPV vaccine",                             "type": "option", "options": ["1. Yes", "2. No", "3. Does not know"]},

    {"field": "21",   "key": "21_cervix_appearance",          "label": "Appearance of the cervix",                "type": "option",
     "options": ["1. Normal-appearing", "2. Ectropion", "3. Inflamed (cervicitis)", "4. Suspicious lesion", "5. Not visualized"]},
    {"field": "22",   "key": "22_collection_instrument",      "label": "Collection instrument",                   "type": "option",
     "options": ["1. Ayre spatula", "2. Cytobrush", "3. Spatula and cytobrush", "4. Broom (liquid-based)"]},
    {"field": "23",   "key": "23_sample_type",                "label": "Sample type",                             "type": "option", "options": ["1. Conventional smear", "2. Liquid-based"]},
    {"field": "24",   "key": "24_collected_by",               "label": "Collected by",                            "type": "text"},
    {"field": "25",   "key": "25_lab_received_date",          "label": "Date received at the laboratory",         "type": "date"},

    {"field": "26",   "key": "26_sample_adequacy",            "label": "Sample adequacy",                         "type": "option", "options": ["1. Adequate", "2. Inadequate"]},
    {"field": "26.1", "key": "26.1_transformation_zone",      "label": "Transformation zone component present",   "type": "option", "options": ["1. Yes", "2. No"], "nullable": true},
    {"field": "27",   "key": "27_bethesda_diagnosis",         "label": "Bethesda diagnosis",                      "type": "option", "nullable": true,
     "options": [
       "1. Negative for intraepithelial lesion or malignancy (NILM)",
       "2. Atypical squamous cells of undetermined significance (ASC-US)",
       "3. Atypical squamous cells, cannot exclude HSIL (ASC-H)",
       "4. Low-grade squamous intraepithelial lesion (LSIL)",
       "5. High-grade squamous intraepithelial lesion (HSIL)",
       "6. Squamous cell carcinoma",
       "7. Atypical glandular cells (AGC)",
       "8. Adenocarcinoma"
     ]},
    {"field": "28",   "key": "28_repeat_study",               "label": "Repeat study",                            "type": "option", "options": ["1. Yes", "2. No"]},
    {"field": "28.1", "key": "28.1_repeat_reason",            "label": "Reason for repeat",                       "type": "option", "nullable": true,
     "options": ["1. Insufficient cellularity", "2. Obscured by blood", "3. Thick smear", "4. Poorly fixed sample",
                 "5. Obscured by inflammation", "6. Broken or unlabeled slide", "7. Other"]},
    {"field": "29",   "key": "29_other_findings",             "label": "Other findings",                          "type": "option_list",
     "options": [
       "A1. Trichomonas vaginalis",
       "A2. Fungal organisms consistent with Candida spp.",
       "A3. Shift in flora suggestive of bacterial vaginosis",
       "A4. Bacteria consistent with Actinomyces spp.",
       "A5. Cellular changes consistent with herpes simplex virus",
       "B1. Reactive cellular changes associated with inflammation",
       "B2. Reactive cellular changes associated with radiation",
       "B3. Reactive cellular changes associated with IUD",
       "B4. Atrophy",
       "B5. Glandular cells status post hysterectomy",
       "C1. Endometrial cells in a woman 45 years or older"
     ],
     "categories": {"A": "Organisms", "B": "Other non-neoplastic findings", "C": "Other"}},
    {"field": "30",   "key": "30_pathologist_review",         "label": "Reviewed by a pathologist",               "type": "option", "options": ["1. Yes", "2. No"]},
    {"field": "30.1", "key": "30.1_pathologist_name",         "label": "Pathologist",                             "type": "text", "nullable": true},
    {"field": "31",   "key": "31_recommendation",             "label": "Recommendation",                          "type": "option",
     "options": ["1. Routine screening according to guidelines", "2. Repeat cytology", "3. Refer to colposcopy",
                 "4. Treat and repeat cytology", "5. Refer to oncology"]},
    {"field": "32",   "key": "32_cytotechnologist",           "label": "Cytotechnologist",                        "type": "text"},
    {"field": "33",   "key": "33_report_date",                "label": "Report date",                             "type": "date"}
  ],

